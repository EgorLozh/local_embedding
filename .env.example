# ---------------------------------------------------------------------------
# vLLM (GPU inference)
# ---------------------------------------------------------------------------

# Docker image tag for vLLM OpenAI server
VLLM_IMAGE_TAG=latest

# HuggingFace model served by vLLM
EMBEDDING_MODEL=BAAI/bge-m3

# Optional: HuggingFace token for gated/private models
HF_TOKEN=

# Host path mounted into vLLM for model cache (speeds up restarts)
HF_CACHE_DIR=~/.cache/huggingface

# GPU settings
NVIDIA_GPU_COUNT=1
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=256

# ---------------------------------------------------------------------------
# FastAPI API service
# ---------------------------------------------------------------------------

API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Upstream vLLM (inside Docker network; do not change unless you rename the service)
VLLM_BASE_URL=http://vllm:8000
VLLM_EMBEDDINGS_PATH=/v1/embeddings

# HTTP client tuning (low latency)
HTTP_TIMEOUT_SEC=30.0
HTTP_CONNECT_TIMEOUT_SEC=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20

# Retry when vLLM is temporarily unavailable
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SEC=0.5
RETRY_MAX_WAIT_SEC=4.0

# Batch limits
BATCH_MAX_TEXTS=64
