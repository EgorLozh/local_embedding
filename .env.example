# ---------------------------------------------------------------------------
# TEI (Text Embeddings Inference)
# https://huggingface.co/docs/text-embeddings-inference
# ---------------------------------------------------------------------------

# CPU image (docker-compose.cpu.yml — default base compose)
TEI_CPU_IMAGE_TAG=cpu-1.9

# GPU image tags (docker-compose.gpu.yml only):
#   cuda-1.9   universal (safe default)
#   89-1.9     Ada Lovelace (RTX 40xx)
#   86-1.9     Ampere 8.6 (RTX 30xx, A10)
#   turing-1.9 Turing (T4, RTX 20xx, experimental)
TEI_GPU_IMAGE_TAG=cuda-1.9

# HuggingFace model served by TEI
EMBEDDING_MODEL=BAAI/bge-m3

# Optional: HuggingFace token for gated/private models
HF_TOKEN=

# Host path mounted into TEI for model cache (speeds up restarts)
HF_CACHE_DIR=~/.cache/huggingface

# GPU settings
NVIDIA_GPU_COUNT=1
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CONCURRENT_REQUESTS=512

# ---------------------------------------------------------------------------
# FastAPI API service
# ---------------------------------------------------------------------------

API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Upstream TEI (inside Docker network; do not change unless you rename the service)
VLLM_BASE_URL=http://tei:80
VLLM_EMBEDDINGS_PATH=/v1/embeddings

# HTTP client tuning (low latency)
HTTP_TIMEOUT_SEC=30.0
HTTP_CONNECT_TIMEOUT_SEC=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20

# Retry when TEI is temporarily unavailable
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SEC=0.5
RETRY_MAX_WAIT_SEC=4.0

# Batch limits
BATCH_MAX_TEXTS=64
